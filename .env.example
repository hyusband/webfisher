# Neon.tech Database Connections
# Obtén estas URLs desde tu Dashboard de Neon (Dashboard > Connection Details)

# 1. Conexión con Connection Pooling (marca el checkbox 'Pooled connection' en Neon):
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP-XYZ]-pooler.[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# 2. Conexión Directa (desmarca el checkbox 'Pooled connection' en Neon):
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[EP-XYZ].[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:5731"
NEXTAUTH_SECRET="tu_secreto_aleatorio_aqui"
